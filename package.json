{
  "name": "devops-cli",
  "version": "0.1.0",
  "description": "DevOpsPlatform CLI - Tool layer for LLM/Agent integration",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "dops": "bin/dops"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "setup": "node scripts/setup.js",
    "postinstall": "node scripts/install.js",
    "build:pkg": "pnpm run build && pnpm run package",
    "build:standalone": "node scripts/build-standalone.js",
    "package": "node scripts/package.js",
    "install:local": "node scripts/setup.js --yes",
    "dops": "node dist/main.js"
  },
  "keywords": [
    "devops",
    "cli",
    "pipeline",
    "scm",
    "tools",
    "mcp"
  ],
  "author": "DevOps Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.4.1",
    "@types/react": "^19.2.14",
    "axios": "^1.8.4",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "cosmiconfig": "^9.0.0",
    "glob": "^13.0.6",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "keyv": "^5.3.2",
    "ora": "^8.2.0",
    "react": "^19.2.4",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
